# Local Coach platform config (Docker Compose).
# Copy to .env and edit. Compose loads .env automatically for ${VAR} interpolation.
#   cp .env.example .env
#
# Recreate containers after any change:
#   docker compose --profile core up -d --build
#   # or Path B / real model:
#   docker compose --profile llm up -d --build
#
# Path A (stub model, no GitHub): leave Path B and Path C sections commented/empty.
# Do not commit .env (gitignored).

# -----------------------------------------------------------------------------
# Path B — real OpenAI-compatible model (Ollama / llama.cpp / cloud)
# Uncomment and set MODEL_GATEWAY_MODEL to an id from the server's /v1/models.
# -----------------------------------------------------------------------------
# AIGW_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# AIGW_OPENAI_API_KEY=unused
# MODEL_GATEWAY_MODEL=qwen3.5:4b
# MODEL_GATEWAY_TIMEOUT=120s
# MODEL_GATEWAY_DISABLE_THINKING=1
# MODEL_GATEWAY_API_KEY=unused
#
# Gemma 4 example:
# MODEL_GATEWAY_MODEL=gemma4:12b
#
# llama.cpp example:
# AIGW_OPENAI_BASE_URL=http://host.docker.internal:8081/v1
# MODEL_GATEWAY_MODEL=local
# MODEL_GATEWAY_DISABLE_THINKING=
#
# Optional judgment packing / budget (worker defaults shown):
# COACH_JUDGMENT_MAX_WALL_TIME=10m
# COACH_MAX_HIDDEN_MUTATION_JUDGMENTS=16
# COACH_MAX_FINDINGS_PER_JUDGMENT_PACK=4
# COACH_MAX_JUDGMENT_PROMPT_TOKENS=3500
# COACH_JUDGMENT_FILE_AFFINITY_MIN_FINDINGS=5
# COACH_JUDGMENT_EVIDENCE_WINDOW_LINES=15

# -----------------------------------------------------------------------------
# Path C — GitHub.com scans (OAuth App + GitHub App)
# PEM convention: secrets/github-app.pem on the host is mounted at
# /secrets/github-app.pem in coach-api and coach-worker (see compose.yaml).
# Create the PEM via deploy/compose/platform/complete-github-app-manifest.sh
# -----------------------------------------------------------------------------
# COACH_GITHUB_OAUTH_CLIENT_ID=
# COACH_GITHUB_OAUTH_CLIENT_SECRET=
# COACH_GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/oauth/github/callback
# COACH_GITHUB_APP_ID=
# COACH_GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem
#
# Optional larger-repo budgets on the worker:
# COACH_BASELINE_MAX_FILES=20000
# COACH_BASELINE_MAX_TOTAL_BYTES=104857600
