# Deterministic OpenAI-compatible chat-completions stub for core platform smoke.
FROM golang:1.26-alpine@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/model-stub ./cmd/model-stub

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/model-stub /usr/local/bin/model-stub
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/model-stub"]
