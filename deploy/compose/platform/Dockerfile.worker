# coach-worker image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:d200d2dd76b03a99b52651fd1325aff7dcd35422c35c01bac56571b0507f3deb AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-worker ./cmd/coach-worker

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache ca-certificates
COPY --from=build /out/coach-worker /usr/local/bin/coach-worker
ENTRYPOINT ["/usr/local/bin/coach-worker"]
