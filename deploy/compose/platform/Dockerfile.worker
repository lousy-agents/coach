# coach-worker image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:738d1cf061836894ff6bb8c33881080ac66de8cf0586615012a0c8f592649cfa AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-worker ./cmd/coach-worker

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates
COPY --from=build /out/coach-worker /usr/local/bin/coach-worker
ENTRYPOINT ["/usr/local/bin/coach-worker"]
