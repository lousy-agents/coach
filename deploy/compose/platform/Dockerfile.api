# coach-api image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:e9bbdf282b51ac8b34c46e5f31d2d56e7bad60366c35f08d2f295b921b13388b AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-api ./cmd/coach-api

FROM alpine:3.24@sha256:e7c4abb69531cb09e2a2bbb56fad3367ab694865c49df898c1c683185cc4376c
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/coach-api /usr/local/bin/coach-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/coach-api"]
