# coach-api image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-api ./cmd/coach-api

FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/coach-api /usr/local/bin/coach-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/coach-api"]
