# coach-api image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:d530cf60723abf1ffae0cd16bb546b379ec0550d2f3815e5b16ed69dbc00fba4 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-api ./cmd/coach-api

FROM alpine:3.24@sha256:71e9b7bae160ba167fa17414401b94cbcdaf3c32feeab9298bd794a2a0614c35
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/coach-api /usr/local/bin/coach-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/coach-api"]
