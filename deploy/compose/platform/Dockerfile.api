# coach-api image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-api ./cmd/coach-api

FROM alpine:3.24@sha256:3f4d6b32e26703c6082839234f43769d5046b3ac7c910033911d1e71d8cd630a
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/coach-api /usr/local/bin/coach-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/coach-api"]
