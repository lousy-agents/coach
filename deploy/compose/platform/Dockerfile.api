# coach-api image for the local platform compose stack (issue #108 / Task 10).
FROM golang:1.27-alpine@sha256:dbaa054703263d06c8b49576667418473b6231f8c0fa69dee103207fdb8e3654 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/coach-api ./cmd/coach-api

FROM alpine:3.24@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
RUN apk add --no-cache ca-certificates wget
COPY --from=build /out/coach-api /usr/local/bin/coach-api
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/coach-api"]
