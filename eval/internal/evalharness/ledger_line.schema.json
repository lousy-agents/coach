{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coach-eval ledger line, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "recorded",
    "cell",
    "run"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "enum": [
        "pre_run",
        "study",
        "census",
        "history",
        "baseline"
      ]
    },
    "recorded": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "cell": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "census"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "run": {
            "$ref": "census_run.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "run": {
            "$ref": "run.schema.json"
          }
        }
      }
    }
  ]
}
