{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coach-eval run record, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state",
    "coach_sha",
    "worktree_dirty",
    "protocol_hash",
    "solver",
    "isolation",
    "image",
    "runtime",
    "architecture",
    "grader_versions",
    "caps",
    "prompt_hash",
    "oracle_hash",
    "parameters",
    "usage",
    "results"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["complete", "paused", "incomplete", "killed", "invalid"]},
    "coach_sha": {"type": "string", "minLength": 1},
    "worktree_dirty": {"type": "boolean"},
    "protocol_hash": {"type": "string", "minLength": 1},
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "model"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "isolation": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "grader_versions": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trials", "tokens", "turns", "timeout_seconds", "run_hours"],
      "properties": {
        "trials": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "turns": {"type": "integer", "minimum": 0},
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "run_hours": {"type": "number", "minimum": 0}
      }
    },
    "prompt_hash": {"type": "string", "minLength": 1},
    "oracle_hash": {"type": "string", "minLength": 1},
    "profile": {"description": "The identity of the pattern profile the run's cells were drawn from, or null for a run without one (#872).", "type": ["string", "null"]},
    "parameters": {
      "type": "object",
      "additionalProperties": {"type": ["integer", "number", "string", "boolean"]}
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "turns", "hours"],
      "properties": {
        "tokens": {"type": "integer", "minimum": 0},
        "turns": {"type": "integer", "minimum": 0},
        "hours": {"type": "number", "minimum": 0}
      }
    },
    "results": {
      "type": "object",
      "properties": {
        "clean_success": {"type": "number", "minimum": 0, "maximum": 1},
        "trials": {"type": "integer", "minimum": 0}
      }
    }
  }
}
